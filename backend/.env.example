VEINCAD_APP_NAME=VeinCAD CNC
VEINCAD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VEINCAD_MAX_UPLOAD_MB=25
# Keep below Cloudflare R2's 10 GB free storage allowance.
VEINCAD_STORAGE_QUOTA_GB=9.5
VEINCAD_STORAGE_BACKEND=local
VEINCAD_ENABLE_SAM2=false
VEINCAD_AUTH_COOKIE_SECURE=false
VEINCAD_SESSION_DAYS=7
VEINCAD_SEED_ADMIN_EMAIL=slokermoliti@gmail.com
VEINCAD_SEED_ADMIN_PASSWORD=Test123
VEINCAD_FRONTEND_URL=http://127.0.0.1:3000
VEINCAD_PASSWORD_RESET_MINUTES=30

# Optional Cloudflare R2 object storage. Use this for hosted file persistence.
# Keep these values in host secrets/env vars only; never commit real keys.
# VEINCAD_STORAGE_BACKEND=r2
# VEINCAD_R2_ACCOUNT_ID=
# VEINCAD_R2_ACCESS_KEY_ID=
# VEINCAD_R2_SECRET_ACCESS_KEY=
# VEINCAD_R2_BUCKET_NAME=veincad-storage
# VEINCAD_R2_PREFIX=veincad
# Optional only if you later configure a public/custom R2 domain.
# VEINCAD_R2_PUBLIC_BASE_URL=

# Required for real forgot-password email delivery.
# Without SMTP settings, reset links are printed in the backend server log for local development.
# VEINCAD_SMTP_HOST=smtp.gmail.com
# VEINCAD_SMTP_PORT=587
# VEINCAD_SMTP_USERNAME=
# VEINCAD_SMTP_PASSWORD=
# VEINCAD_SMTP_FROM_EMAIL=
# VEINCAD_SMTP_USE_TLS=true

# Required only when enabling the AI CAD chat to call a hosted model.
# OPENAI_API_KEY=
# VEINCAD_OPENAI_MODEL=gpt-5.4-nano
# GEMINI_API_KEY=
VEINCAD_GEMINI_MODEL=gemini-2.5-flash-lite

# Optional SAM 2 settings. Use either HF model name or checkpoint+config.
# VEINCAD_SAM2_HF_MODEL=facebook/sam2-hiera-large
# VEINCAD_SAM2_CHECKPOINT=C:\models\sam2.1_hiera_large.pt
# VEINCAD_SAM2_MODEL_CFG=configs/sam2.1/sam2.1_hiera_l.yaml
# VEINCAD_SAM2_DEVICE=auto
